// Firestore Security Rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(uid())) &&
             get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true;
    }
    function userHousehold() {
      return exists(/databases/$(database)/documents/users/$(uid())) ?
        get(/databases/$(database)/documents/users/$(uid())).data.householdId : null;
    }

    // users: 自分のプロフィールのみ書き込み可（管理者は全読み取り可）
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == uid() || isAdmin());
      allow write: if isSignedIn() && userId == uid();
    }

    // goals: 自分の household のみ読書き可（管理者は全権）
    match /goals/{goalId} {
      allow read: if isSignedIn() && (resource.data.householdId == userHousehold() || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
    }

    // transactions: 自分の household のみ読書き可（管理者は全権）
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.householdId == userHousehold() || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
    }

    // 週次自炊イベント（1日1件/種別）
    match /weeklyCooking/{id} {
      allow read: if isSignedIn() && (resource.data.householdId == userHousehold() || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
      allow delete: if false;
    }

    // 週別の集計カウンタ（read をサインインのみ許可：初回購読対策）
    match /weeklyCookingCounters/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
      allow delete: if false;
    }

    // 世帯累計カウンタ（docId は householdId 想定）（read 緩和）
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
      allow delete: if false;
    }

    // 月次指標（予算達成/食費5万未満/節約額）（read 緩和）
    match /monthlyMetrics/{metricId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.resource.data.householdId == userHousehold() || isAdmin());
      allow delete: if false;
    }

    // weeklySelections: 自分の household かつ自分自身(uid)のみ create/update 可
    match /weeklySelections/{selId} {
      // household の一致が確認できる場合のみ読み取り許可（管理者は全権）
      allow read: if isSignedIn() && (resource.data.householdId == userHousehold() || isAdmin());

      // 作成・更新は自分の household かつ userId == uid() のみ
      // 選択肢はホワイトリストで制限
      allow create, update: if isSignedIn() &&
        request.resource.data.householdId == userHousehold() &&
        request.resource.data.userId == uid() &&
        request.resource.data.selectedActionId in [
          'limit_convenience_2',
          'limit_diningout_1',
          'food_under_3000'
        ];

      // 削除は無効（必要なら調整）
      allow delete: if false;
    }
  }
}